          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "append-row-in-sheet",
      "name": "Append row in sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        912,
        624
      ],
      "notes": "Guarda cada reserva confirmada (fecha, hora, personas, nombre, numero) en la planilla 'Reservas Restaurante Colo', pestaña 'Reservas'. El numero se toma del webhook original (no de la respuesta de FastAPI), y el resto de datos.reserva que arma app/claude_client.py.",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "<GOOGLE_SHEETS_CREDENTIAL_ID>",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/<WHATSAPP_PHONE_ID>/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <WHATSAPP_TOKEN>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messaging_product\": \"whatsapp\", \"to\": $('Webhook POST (mensajes)').item.json.body.entry[0].changes[0].value.messages[0].from.replace(/^549(\\d+)$/, '54$1'), \"type\": \"text\", \"text\": { \"body\": $('Llamar a FastAPI').item.json.respuesta } } }}",
        "options": {}
      },
      "id": "http-whatsapp-reply",
      "name": "Responder por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1152,
        624
      ],
      "notes": "Completar <WHATSAPP_PHONE_ID> en la URL y <WHATSAPP_TOKEN> en el header Authorization a mano, con los valores reales del .env, antes de activar el workflow. El body de texto referencia 'Llamar a FastAPI' explicitamente (no $json a secas), para no romperse si se insertan mas nodos en el medio de la cadena - ver bitacora Dia 4, Error 2."
    },
    {
      "position": [
        464,
        624
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ !!$json.body?.entry?.[0]?.changes?.[0]?.value?.messages }}",
              "id": "hay-messages-check",
              "operator": {
                "type": "boolean",
                "singleValue": true,
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and",
          "options": {
            "typeValidation": "strict",
            "leftValue": "",
            "caseSensitive": true,
            "version": 3
          }
        },
        "options": {}
      },
      "id": "filtrar-eventos-estado",
      "notes": "Los webhooks de status (delivered/read) de WhatsApp no traen 'messages' en el payload, solo 'statuses'. Sin este filtro, 'Llamar a FastAPI' rompe con 'JSON parameter needs to be valid JSON' al armar el body con un campo inexistente.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "name": "Filtrar eventos de estado"
    },
    {
      "position": [
